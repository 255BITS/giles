{
  "name": "giles",
  "version": "0.6.0",
  "author": "Martyn Garcia <martyn.garcia@gmail.com>",
  "description": "a next-gen language watcher/compiler for pre-processed languages",
  "bin": {
    "giles": "bin/giles.bin.js"
  },
  "main": "dist/giles.js",
  "files": [
    "bin/",
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/255BITS/giles.git"
  },
  "keywords": [
    "cli",
    "coffeescript",
    "stylus",
    "jade",
    "html5",
    "compiler",
    "watcher",
    "server"
  ],
  "scripts": {
    "build": "coffee --compile --output dist giles.coffee log.coffee",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "cli-color": "^2.0.4",
    "coffeescript": "^2.7.1",
    "commander": "^14.0.3",
    "connect": "^3.7.0",
    "iced-coffee-script": "^108.0.14",
    "marked": "^18.2.1",
    "pug": "^3.0.4",
    "serve-static": "^2.2.1",
    "stylus": "0.63.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  }
}
